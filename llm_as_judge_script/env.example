# LLM Auto Scoring Script Configuration
# Copy this file to .env and fill in your API keys

# ===========================================
# LLM API Keys (configure the ones you need)
# ===========================================

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# OpenAI ChatGPT
CHATGPT_API_KEY=your-chatgpt-api-key
CHATGPT_BASE_URL=https://api.openai.com/v1

# OpenRouter (provides access to multiple models)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ===========================================
# LLM Settings
# ===========================================

# Default model to use
LLM_DEFAULT_MODEL=OpenRouter-Gemini-3.0-Pro

# Request timeout in seconds
LLM_TIMEOUT=180

# Maximum retry attempts for failed requests
LLM_MAX_RETRIES=3

# Retry wait time range (seconds)
LLM_RETRY_MIN_WAIT=1
LLM_RETRY_MAX_WAIT=30

# Maximum concurrent requests
LLM_MAX_CONCURRENT=5

# ===========================================
# Optional Settings
# ===========================================

# Enable Google Search Grounding (Gemini models only)
ENABLE_GOOGLE_SEARCH_GROUNDING=false

# PPTX rendering mode: text | image | auto
PPTX_RENDER_MODE=text
PPTX_RENDER_DPI=150
PPTX_RENDER_MAX_SLIDES=50

# Maximum HTML content length to process
MAX_HTML_CONTENT_LENGTH=100000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
